# นำค่า Project URL และ anon public key จากหน้า Supabase Dashboard -> Project Settings -> API มาวางที่นี่
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# โหมดเดโมนำเสนอ (true = เปิดปุ่มช่วยสาธิต เช่น กรอกตัวอย่าง/จำลองสลิป/แถบรหัสใบจอง | false = โหมดใช้งานจริง ซ่อนปุ่มเดโมทั้งหมด)
VITE_DEMO_MODE=true
